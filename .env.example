# Local development only. Generate four distinct passwords (16+ characters).
# Example generator: python3 -c 'import secrets; print(secrets.token_hex(24))'
POSTGRES_PASSWORD=
WATERGEO_MIGRATION_PASSWORD=
WATERGEO_DB_PASSWORD=
WATERGEO_INGESTION_PASSWORD=

# Host-based tools connect to the loopback-only Compose port.
# Compose overrides the hostname to db for container-based tools.
WATERGEO_DB_HOST=127.0.0.1
WATERGEO_DB_PORT=5432
WATERGEO_DB_NAME=watergeo
# Remote deployments: verify server identity using a trusted CA file.
# Leave unset for the existing local Docker connection behavior.
# WATERGEO_DB_SSLMODE=verify-full
# WATERGEO_DB_SSLROOTCERT=/path/to/trusted-database-ca.pem
WATERGEO_LOG_LEVEL=INFO

# Production only: both settings are required together with verify-full database TLS.
# Use JSON syntax because the application accepts more than one public hostname.
# WATERGEO_SERVICE_ENVIRONMENT=production
# WATERGEO_TRUSTED_HOSTS=["api.example.org"]

# Optional operator age limits (seconds, 1..31536000). Unset means unknown.
# Choose for your service needs; these are not Environment Agency guarantees.
# WATERGEO_HYDROLOGY_RETRIEVAL_MAX_AGE_SECONDS=3600
# WATERGEO_HYDROLOGY_OBSERVATION_MAX_AGE_SECONDS=86400
# WATERGEO_WATER_QUALITY_RETRIEVAL_MAX_AGE_SECONDS=604800
