# Local development only. Generate three distinct passwords (16+ characters).
# Example generator: python3 -c 'import secrets; print(secrets.token_hex(24))'
POSTGRES_PASSWORD=
WATERGEO_MIGRATION_PASSWORD=
WATERGEO_DB_PASSWORD=

# Host-based tools connect to the loopback-only Compose port.
# Compose overrides the hostname to db for container-based tools.
WATERGEO_DB_HOST=127.0.0.1
WATERGEO_DB_PORT=5432
WATERGEO_DB_NAME=watergeo
WATERGEO_LOG_LEVEL=INFO
