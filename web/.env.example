# Optional same-origin path prefix, for example /watergeo. Never put secrets in VITE_*.
VITE_API_BASE_PATH=

# Leave empty for the context-free fallback, or configure a reviewed MapLibre style URL.
VITE_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Optional same-origin snapshot export; leave unset to omit the overview control.
# VITE_WATER_SUPPLY_OVERVIEW=/exports/SNAPSHOT/manifest.json
